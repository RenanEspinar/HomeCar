<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <me.aap.fermata.addon.web.FermataWebView
        android:id="@+id/browserWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!--
        One focusable view per dashboard control. Android Auto moves the iDrive
        rotation between focusable views; the WebView itself is a single target.
    -->
    <me.aap.fermata.addon.web.KnobTargetLayout
        android:id="@+id/knobTargets"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:descendantFocusability="afterDescendants"
        android:focusable="false" />

    <FrameLayout
        android:id="@+id/browserFullScreenView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Always available in Android Auto: back in WebView history, or exit
         the HomeCar surface when there is no previous page. -->
    <ImageButton
        android:id="@+id/homeCarBackButton"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_gravity="start|bottom"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="12dp"
        android:alpha="0.75"
        android:background="@drawable/home_car_settings_button"
        android:contentDescription="@string/home_car_back_or_exit"
        android:elevation="12dp"
        android:padding="11dp"
        android:src="@android:drawable/ic_media_previous"
        android:tint="#FFFFFF"
        android:visibility="gone" />

    <!--
        HOME CAR server configuration.
        Small, semi-transparent button so it remains available without
        taking over the Home Assistant dashboard.
    -->
    <ImageButton
        android:id="@+id/homeCarSettingsButton"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:alpha="0.72"
        android:background="@drawable/home_car_settings_button"
        android:contentDescription="@string/home_car_server_settings"
        android:elevation="12dp"
        android:padding="11dp"
        android:src="@drawable/home_car_settings"
        android:tint="#FFFFFF" />

</FrameLayout>
